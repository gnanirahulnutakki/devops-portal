FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /bin/agent ./agent/cmd/agent

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /bin/agent /agent
ENTRYPOINT ["/agent"]
CMD ["-gateway", "http://protocol-gateway:8080", "-agent-name", "cluster-agent"]
