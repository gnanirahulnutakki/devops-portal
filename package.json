{
  "name": "devops-portal",
  "version": "0.1.0",
  "private": false,
  "description": "Self-hostable, multi-cluster Kubernetes operations portal. Browse pods/workloads/services/ingresses, view live events and logs, and proxy your existing platform tooling (ArgoCD, Prometheus, Grafana, Loki) — all from one UI.",
  "license": "Apache-2.0",
  "author": "Gnani Rahul Nutakki",
  "homepage": "https://github.com/gnanirahulnutakki/devops-portal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnanirahulnutakki/devops-portal.git"
  },
  "bugs": {
    "url": "https://github.com/gnanirahulnutakki/devops-portal/issues"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "devops",
    "platform-engineering",
    "argocd",
    "prometheus",
    "grafana",
    "multi-cluster",
    "internal-developer-platform",
    "idp",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-monaco.js && prisma generate && next build",
    "start": "tsx server.ts",
    "start:next-only": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup-rls": "tsx scripts/setup-rls.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@kubernetes/client-node": "^1.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/rest": "^21.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-prometheus": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@prisma/client": "^6.3.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@tremor/react": "^3.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.28.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.5.6",
    "ioredis": "^5.4.1",
    "ky": "^1.7.3",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.55.1",
    "next": "15.5.15",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.0",
    "swagger-ui-react": "^5.31.0",
    "swr": "^2.4.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "undici": "^7.21.0",
    "whatwg-url": "^16.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.2.0",
    "postcss": "^8.5.10",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "protobufjs": "^8.0.1",
    "dompurify": "^3.4.0",
    "lodash": "^4.18.0",
    "follow-redirects": "^1.16.0",
    "brace-expansion": "^5.0.5",
    "picomatch": "^4.0.4",
    "uuid": "^11.1.1",
    "defu": "^6.1.5",
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
